server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # Necesario para que nginx mande el nombre del backend por TLS (SNI)
        # y por el header Host — sin esto, plataformas como Render (que
        # enrutan por nombre de dominio) rechazan el handshake HTTPS.
        proxy_ssl_server_name on;
        proxy_pass ${API_BASE_URL};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
