# Copiar a ".env" en la raíz del repo y completar antes de "docker compose up".
# No commitear el .env real (ya está en .gitignore).

# Primer usuario administrador (se crea al correr el script de migración,
# back/server/scripts/migrar_json_a_bd.js). Para sumar más cuentas después,
# usar back/server/scripts/crear_admin.js — ver back/db/README.md.
ADMIN_USER=admin
ADMIN_PASSWORD=

JWT_SECRET=

# Credenciales del contenedor de PostgreSQL (docker-compose.yml). El API
# arma solo la URL de conexión a partir de estos tres valores.
POSTGRES_USER=horarios
POSTGRES_PASSWORD=
POSTGRES_DB=horarios_aulas
